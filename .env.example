# LeadsEngine AI (Free Edition) Configuration

# Server
PORT=8000
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:8000

# Optional: Free Gemini API Key from https://aistudio.google.com/
# If left blank, built-in heuristic AI parser will be used automatically (100% free)!
GEMINI_API_KEY=

# Optional: SMTP Configuration for sending real cold emails
# If left blank, system operates in SIMULATION / PREVIEW mode so you can test risk-free!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME="Leads Engine"
